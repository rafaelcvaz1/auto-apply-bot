{
  "name": "auto-apply-bot",
  "version": "1.0.0",
  "description": "Busca e revisão local de oportunidades em Dados e Estatística",
  "type": "module",
  "scripts": {
    "start": "node --use-env-proxy --import tsx src/index.ts",
    "dev": "node --use-env-proxy --import tsx --watch src/index.ts",
    "collect": "node --use-env-proxy --import tsx src/discovery/collect-cli.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "simulate": "node --import tsx src/applications/simulate-cli.ts",
    "radar": "node scripts/radar.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "13.2.0",
    "dotenv": "^16.4.0",
    "nodemailer": "10.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/nodemailer": "^6.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.5.0 <25"
  }
}
